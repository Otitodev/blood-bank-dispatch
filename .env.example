# CALL-E API — get a key from the CALL-E dashboard (iams_live_...)
CALLE_API_KEY=
# Production API. Test environment: https://test-api.heycall-e.com
CALLE_BASE_URL=https://api.heycall-e.com

# Postgres (asyncpg DSN)
DATABASE_URL=postgresql://user:password@localhost:5432/bb_dispatch

# Optional tuning (defaults shown)
# Max simultaneous CALL-E calls in one run. Confirm your account's
# concurrency cap before raising this.
CALLE_CONCURRENCY=2
# Hard cap on targets per run (each target is a paid call)
MAX_TARGETS=8
# POST /runs rate limit per client IP: N runs per 10 minutes
RATE_LIMIT_RUNS=6
# Per-call wait budget in seconds
CALLE_CALL_TIMEOUT=600
